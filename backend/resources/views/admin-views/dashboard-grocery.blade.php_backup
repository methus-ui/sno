        /* Notice Scroller Styles */
        .notice-scroller {
            background: linear-gradient(135deg, #005555 0%, #00aa96 100%);
            color: #fff;
            padding: 12px 20px;
            border-radius: 8px;
            margin-bottom: 20px;
            overflow: hidden;
            position: relative;
        }
        .notice-scroller .notice-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 20px;
            z-index: 2;
        }
        .notice-scroller .marquee-wrapper {
            margin-left: 40px;
            overflow: hidden;
        }
        .notice-scroller .marquee-content {
            display: inline-block;
            white-space: nowrap;
            animation: marquee 20s linear infinite;
        }
        .notice-scroller .marquee-content:hover {
            animation-play-state: paused;
        }
        @keyframes marquee {
            0% { transform: translateX(100%); }
            100% { transform: translateX(-100%); }
        }

        /* Employee Dashboard Clock Styles */
        .employee-clock-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 15px;
            padding: 25px;
            color: #fff;
            text-align: center;
            box-shadow: 0 10px 30px rgba(102, 126, 234, 0.3);
        }
        .employee-clock-card .clock-time {
