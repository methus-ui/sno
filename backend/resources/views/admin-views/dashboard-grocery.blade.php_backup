            border-bottom: none;
            padding: 15px 20px;
        }
        .notes-card .note-item {
            padding: 12px 15px;
            border-bottom: 1px solid #f0f0f0;
            transition: background 0.2s ease;
        }
        .notes-card .note-item:hover {
            background: #f9f9f9;
        }
        .notes-card .note-item:last-child {
            border-bottom: none;
        }
        .notes-card .note-time {
            font-size: 11px;
            color: #999;
        }

        /* Punch Button Styles */
        .punch-btn {
            padding: 15px 30px;
            font-size: 16px;
            font-weight: 600;
            border-radius: 10px;
            transition: all 0.3s ease;
        }
        .punch-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
        .punch-btn-in {
            background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            border: none;
            color: #fff;
        }
        .punch-btn-in:hover:not(:disabled) {
            transform: scale(1.05);
            box-shadow: 0 5px 20px rgba(17, 153, 142, 0.4);
        }
        .punch-btn-out {
            background: linear-gradient(135deg, #eb3349 0%, #f45c43 100%);
            border: none;
            color: #fff;
        }
        .punch-btn-out:hover:not(:disabled) {
            transform: scale(1.05);
            box-shadow: 0 5px 20px rgba(235, 51, 73, 0.4);
        }

