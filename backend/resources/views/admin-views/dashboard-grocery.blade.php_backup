            transition: transform 0.3s ease, box-shadow 0.3s ease;
            height: 100%;
        }
        .employee-stat-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.12);
        }
        .employee-stat-card .stat-icon {
            width: 60px;
