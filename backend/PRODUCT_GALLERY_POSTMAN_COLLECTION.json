{
  "info": {
    "name": "Vendor App - Product Gallery API",
    "description": "Complete API collection for Product Gallery feature - Browse and replicate products from other stores",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "product-gallery-collection",
    "version": "1.0.0"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{vendor_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://your-domain.com/api/v1",
      "type": "string"
    },
    {
      "key": "vendor_token",
      "value": "your_bearer_token_here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "0. Auth - Vendor Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"vendor@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/vendor/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "vendor", "login"]
        },
        "description": "Login to get vendor bearer token. Copy the token from response and set it in collection variable 'vendor_token'"
      },
      "response": []
    },
    {
      "name": "1. Browse Product Gallery",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/vendor/product-gallery/browse?page=1&limit=20&exclude_my_products=true",
          "host": ["{{base_url}}"],
          "path": ["vendor", "product-gallery", "browse"],
          "query": [
            {
              "key": "page",
              "value": "1",
              "description": "Page number (default: 1)"
            },
            {
              "key": "limit",
              "value": "20",
              "description": "Items per page (default: 20)"
            },
            {
              "key": "search",
              "value": "apple",
              "disabled": true,
              "description": "Search term (optional)"
            },
            {
              "key": "category_id",
              "value": "5",
              "disabled": true,
              "description": "Filter by category (optional)"
            },
            {
              "key": "store_id",
              "value": "10",
              "disabled": true,
              "description": "Filter by store (optional)"
            },
            {
              "key": "exclude_my_products",
              "value": "true",
              "description": "Hide your own products"
            }
          ]
        },
        "description": "Browse all products from other stores in the marketplace. Supports search, category filter, and pagination."
      },
      "response": []
    },
    {
      "name": "2. Browse with Search",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/vendor/product-gallery/browse?search=apple&page=1&limit=10",
          "host": ["{{base_url}}"],
          "path": ["vendor", "product-gallery", "browse"],
          "query": [
            {
              "key": "search",
              "value": "apple"
            },
            {
              "key": "page",
              "value": "1"
            },
            {
              "key": "limit",
              "value": "10"
            }
          ]
        },
        "description": "Search for products by name, description, or barcode"
      },
      "response": []
    },
    {
      "name": "3. Browse by Category",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/vendor/product-gallery/browse?category_id=5&page=1",
          "host": ["{{base_url}}"],
          "path": ["vendor", "product-gallery", "browse"],
          "query": [
            {
              "key": "category_id",
              "value": "5",
              "description": "Category ID to filter"
            },
            {
              "key": "page",
              "value": "1"
            }
          ]
        },
        "description": "Filter products by specific category"
      },
      "response": []
    },
    {
      "name": "4. Get Product Details",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/vendor/product-gallery/details/:product_id",
          "host": ["{{base_url}}"],
          "path": ["vendor", "product-gallery", "details", ":product_id"],
          "variable": [
            {
              "key": "product_id",
              "value": "123",
              "description": "Product ID to view"
            }
          ]
        },
        "description": "Get detailed information about a specific product including variations, addons, reviews, and source store details"
      },
      "response": []
    },
    {
      "name": "5. Replicate Product (Basic)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source_product_id\": 123\n}"
        },
        "url": {
          "raw": "{{base_url}}/vendor/product-gallery/replicate",
          "host": ["{{base_url}}"],
          "path": ["vendor", "product-gallery", "replicate"]
        },
        "description": "Replicate a product to your store with default settings (copies everything: images, variations, addons)"
      },
      "response": []
    },
    {
      "name": "6. Replicate Product (Customized)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source_product_id\": 123,\n  \"customize\": {\n    \"price\": 6.99,\n    \"discount\": 5,\n    \"stock\": 50,\n    \"available_time_starts\": \"09:00:00\",\n    \"available_time_ends\": \"21:00:00\",\n    \"copy_images\": true,\n    \"copy_variations\": true,\n    \"copy_addons\": true,\n    \"copy_attributes\": true,\n    \"is_recommended\": false,\n    \"veg\": 1\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/vendor/product-gallery/replicate",
          "host": ["{{base_url}}"],
          "path": ["vendor", "product-gallery", "replicate"]
        },
        "description": "Replicate a product with custom price, stock, and other settings"
      },
      "response": []
    },
    {
      "name": "7. Batch Replicate Products",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"product_ids\": [123, 124, 125, 126],\n  \"default_settings\": {\n    \"discount\": 0,\n    \"stock\": 100,\n    \"copy_images\": true,\n    \"copy_variations\": true,\n    \"copy_addons\": true\n  }\n}"
        },
        "url": {
          "raw": "{{base_url}}/vendor/product-gallery/batch-replicate",
          "host": ["{{base_url}}"],
          "path": ["vendor", "product-gallery", "batch-replicate"]
        },
        "description": "Replicate multiple products at once with same default settings"
      },
      "response": []
    },
    {
      "name": "8. Get Trending Products",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/vendor/product-gallery/trending",
          "host": ["{{base_url}}"],
          "path": ["vendor", "product-gallery", "trending"]
        },
        "description": "Get trending products: most ordered, highest rated, and newest additions"
      },
      "response": []
    },
    {
      "name": "9. My Replication History",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/vendor/product-gallery/my-replications",
          "host": ["{{base_url}}"],
          "path": ["vendor", "product-gallery", "my-replications"]
        },
        "description": "View your product replication history and total product count"
      },
      "response": []
    }
  ]
}
