{
  "info": {
    "name": "Employee Chat API",
    "description": "Internal chat system for admin employees",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://new.snocart.com",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Get Sanctum Token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Cookie",
            "value": "laravel_session=YOUR_SESSION_COOKIE_HERE",
            "description": "Get this from browser after logging into admin panel"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/admin/auth/token",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "admin", "auth", "token"]
        },
        "description": "Generate Sanctum token for authenticated admin. You must be logged into admin panel first. Copy the session cookie from browser."
      },
      "response": []
    },
    {
      "name": "2. Verify Token",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/admin/employee-chat/auth/verify",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "admin", "employee-chat", "auth", "verify"]
        },
        "description": "Verify token is valid"
      },
      "response": []
    },
    {
      "name": "3. Get Available Employees",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/admin/employee-chat/employees",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "admin", "employee-chat", "employees"]
        },
        "description": "Get list of all available employees to chat with"
      },
      "response": []
    },
    {
      "name": "4. Get Conversations",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/admin/employee-chat/conversations",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "admin", "employee-chat", "conversations"]
        },
        "description": "Get all conversations for current user"
      },
      "response": []
    },
    {
      "name": "5. Get Messages in Conversation",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/admin/employee-chat/conversations/3370",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "admin", "employee-chat", "conversations", "3370"]
        },
        "description": "Get all messages in a specific conversation (replace 3370 with actual conversation ID)"
      },
      "response": []
    },
    {
      "name": "6. Send Text Message",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"receiver_id\": 2578,\n    \"message\": \"Hello! This is a test message from Postman.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/api/v1/admin/employee-chat/messages",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "admin", "employee-chat", "messages"]
        },
        "description": "Send a text message to another employee (replace receiver_id with actual UserInfo ID from employees list)"
      },
      "response": []
    },
    {
      "name": "7. Upload File",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": "/path/to/your/file.jpg",
              "description": "Select a file (jpg, png, pdf, doc, docx - max 10MB)"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/admin/employee-chat/upload",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "admin", "employee-chat", "upload"]
        },
        "description": "Upload a file (will return file URL to use in message)"
      },
      "response": []
    },
    {
      "name": "8. Send Message with Files",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "receiver_id",
              "value": "2578",
              "type": "text"
            },
            {
              "key": "message",
              "value": "Here are the files you requested",
              "type": "text"
            },
            {
              "key": "files[]",
              "type": "file",
              "src": "/path/to/file1.jpg"
            },
            {
              "key": "files[]",
              "type": "file",
              "src": "/path/to/file2.pdf"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/v1/admin/employee-chat/messages",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "admin", "employee-chat", "messages"]
        },
        "description": "Send message with multiple file attachments (max 5 files, 10MB each)"
      },
      "response": []
    },
    {
      "name": "9. Poll for New Messages",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/admin/employee-chat/poll?since=1710170000",
          "host": ["{{base_url}}"],
          "path": ["api", "v1", "admin", "employee-chat", "poll"],
          "query": [
            {
              "key": "since",
              "value": "1710170000",
              "description": "Unix timestamp - only return messages after this time"
            }
          ]
        },
        "description": "Poll for new messages since a timestamp (for real-time updates)"
      },
      "response": []
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  }
}
