// Session recovery and auto-save for order editing
@if(session('editing_order_id'))
$(document).ready(function() {
    // Check if we're in edit mode and restore from database if session lost
    var hasSessionCart = {{ session()->has('order_cart') ? 'true' : 'false' }};

    if (!hasSessionCart) {
        // Session lost but edit mode active - trigger recovery
        $.ajax({
            url: '{{ route("admin.order.recover-edit-session") }}',
            method: 'GET',
            success: function(response) {
                if (response.recovered) {
                    toastr.info('{{ translate("messages.edit_session_recovered") }}');
                    location.reload();  // Reload with recovered session
                }
            },
            error: function() {
                console.warn('Session recovery failed');
            }
        });
    }
});

// Auto-save function
function autoSaveEditProgress() {
    if ($('.submit-edit-order').length > 0) {  // In edit mode
        $.ajax({
            url: '{{ route("admin.order.save-edit-progress") }}',
            method: 'POST',
            data: {
                _token: '{{ csrf_token() }}'
            },
            success: function(response) {
                // Silent save - no notification unless error
                if (!response.success) {
                    console.warn('Auto-save failed:', response.message);
                }
            },
            error: function() {
                console.warn('Auto-save request failed');
            }
        });
    }
}

// Auto-save after cart modifications
$(document).on('DOMSubtreeModified', '#order-items-table-wrapper', _.debounce(function() {
    autoSaveEditProgress();
}, 2000));

// Warn before leaving page with unsaved edits
window.addEventListener('beforeunload', function(e) {
    if ($('.submit-edit-order').length > 0) {
        e.preventDefault();
        e.returnValue = '{{ translate("messages.unsaved_order_edits_warning") }}';
        return e.returnValue;
    }
});

// Remove warning when properly saving/cancelling
$(document).on('click', '.submit-edit-order, .cancel-edit-order', function() {
    window.onbeforeunload = null;
});
