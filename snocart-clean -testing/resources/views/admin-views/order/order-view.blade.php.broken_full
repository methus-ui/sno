    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Search functionality for delivery man list
            const searchInput = document.getElementById('dm-search-input');
            if (searchInput) {
                searchInput.addEventListener('keyup', function() {
                    const searchTerm = this.value.toLowerCase();
                    const dmItems = document.querySelectorAll('.dm-list-item');

                    dmItems.forEach(function(item) {
                        const dmName = item.querySelector('.dm-name');
                        const dmPhone = item.querySelector('.dm-phone');
                        let matchFound = false;

                        if (dmName) {
                            const name = dmName.textContent.toLowerCase();
                            if (name.includes(searchTerm)) {
                                matchFound = true;
                            }
                        }

                        // Also search by phone
                        if (dmPhone && dmPhone.dataset.phone) {
                            const phone = dmPhone.dataset.phone.toLowerCase();
                            if (phone.includes(searchTerm)) {
                                matchFound = true;
                            }
                        }

                        item.style.display = matchFound ? '' : 'none';
                    });
                });
            }

            // Zone change - refresh deliveryman list
            const refreshBtn = document.getElementById('refresh-dm-list');
            if (refreshBtn) {
                refreshBtn.addEventListener('click', function() {
                    var zoneId = document.getElementById('zone-change-select').value;
                    if (!zoneId) {
                        toastr.warning('{{ translate("messages.please_select_zone") }}');
                        return;
                    }

                    var btn = this;
                    btn.disabled = true;
                    btn.innerHTML = '<i class="tio-refresh tio-spin"></i>';

                    $.ajax({
                        type: "GET",
                        url: '{{ route("admin.order.get-deliverymen") }}',
                        data: {
                            order_id: '{{ $order->id }}',
                            zone_id: zoneId
                        },
                        success: function(response) {
                            // Replace the lists with new data
                            document.getElementById('in-zone-dm-list').innerHTML = response.in_zone_html;
                            document.getElementById('out-zone-dm-list').innerHTML = response.out_zone_html;

                            // Update counts
                            document.querySelector('.in-zone-count').textContent = response.in_zone_count;
                            document.querySelector('.out-zone-count').textContent = response.out_zone_count;

                            // Update zone name
                            document.getElementById('current-zone-name').textContent = response.zone_name;

                            // Re-bind click handlers for assign buttons
                            bindAssignButtons();

                            toastr.success('{{ translate("messages.list_refreshed") }}');
                        },
                        error: function(xhr) {
                            toastr.error(xhr.responseJSON?.message || '{{ translate("messages.error") }}');
                        },
                        complete: function() {
                            btn.disabled = false;
                            btn.innerHTML = '<i class="tio-refresh"></i> {{ translate("messages.refresh") }}';
                        }
                    });
                });
            }

            // Collapse icon rotation
            $('#outOfZoneSection').on('show.bs.collapse', function () {
                $('.collapse-icon').css('transform', 'rotate(180deg)');
            }).on('hide.bs.collapse', function () {
                $('.collapse-icon').css('transform', 'rotate(0deg)');
            });
        });

        // Function to rebind assign buttons after AJAX refresh
        function bindAssignButtons() {
            $('.add-delivery-man').off('click').on('click', function () {
                var delivery_man_id = $(this).data('id');
                addDeliveryMan(delivery_man_id);
            });

            // Also rebind the dm_list click for map highlighting
            $('.dm_list').off('click').on('click', function () {
                var id = $(this).data('id');
                // Highlight the delivery man on map if applicable
                if (typeof highlightDMOnMap === 'function') {
                    highlightDMOnMap(id);
                }
            });
        }
    </script>
    <!-- End Modal -->

