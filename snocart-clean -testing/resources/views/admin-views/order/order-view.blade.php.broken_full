                }
            });
        }
    });
});

// Show page content after DOM is ready (prevents black flash)
(function() {
    var wrapper = document.getElementById('orderDetailWrapper');
    if (wrapper) {
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', function() { wrapper.classList.add('loaded'); });
        } else {
            wrapper.classList.add('loaded');
        }
    }
})();

