                                            {{-- @php($tax_a=0) --}}
                                            <dt class="col-6">{{ translate('messages.vat/tax') }}:</dt>
                                            <dd class="col-6 text-right">
                                                +
                                                {{ \App\CentralLogics\Helpers::format_currency($total_tax_amount) }}
