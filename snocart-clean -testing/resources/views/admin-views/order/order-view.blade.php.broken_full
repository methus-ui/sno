@php
    // Check if order can be edited based on payment method
    $canEditPayment = false;

    if (count($order?->payments) == 0) {
        // No payment records - allow edit (COD unpaid, etc.)
        $canEditPayment = true;
    } else {
        // Has payment records - check if they're editable
        $hasOnlyEditablePayments = true;
        foreach ($order->payments as $payment) {
            // Allow editing for: wallet, cash_on_delivery, partial_payment
            if (!in_array($payment->payment_method, ['wallet', 'cash_on_delivery', 'partial_payment'])) {
                // Has non-editable payment method (digital, card, etc.)
                $hasOnlyEditablePayments = false;
                break;
            }
        }
        $canEditPayment = $hasOnlyEditablePayments;
    }
@endphp

