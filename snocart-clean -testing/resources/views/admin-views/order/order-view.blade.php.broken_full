<!-- Enhanced Customer Priority Panel - Add this RIGHT AFTER the order timer section -->
@if ($order->customer && $order->is_guest == 0)
    @php
        $orderCount = $order->customer->orders_count ?? 0;
        $customerSince = $order->customer->created_at ? $order->customer->created_at->diffForHumans() : 'N/A';
        $customerDate = $order->customer->created_at ? $order->customer->created_at->format('M d, Y') : 'N/A';
        $daysSinceJoined = $order->customer->created_at ? $order->customer->created_at->diffInDays(now()) : 0;
        $avgOrdersPerMonth = $daysSinceJoined > 0 ? round(($orderCount / max(($daysSinceJoined / 30), 1)), 1) : 0;
        
        // Calculate estimated lifetime value
        $avgOrderValue = $order->order_amount ?? 500;
        $estimatedValue = \App\CentralLogics\Helpers::format_currency($orderCount * $avgOrderValue);
        
        // Last order calculation
        $lastOrderDate = $orderCount > 1 ? 'Recent' : 'First order';
        
        $priorityClass = 'secondary';
        $priorityText = 'New Customer';
        $priorityIcon = 'tio-user-add';
        $priorityBg = '#f8f9fa';
        $priorityBorder = '#dee2e6';
        $staffTip = '';
        $urgencyBadge = '';
        
        if ($orderCount >= 50) {
            $priorityClass = 'danger';
            $priorityText = translate('messages.vip_elite');
            $priorityIcon = 'tio-premium-outlined';
            $priorityBg = '#ffe5e8';
            $priorityBorder = '#dc3545';
            $staffTip = translate('messages.staff_tip_vip_elite');
            $urgencyBadge = translate('messages.vip_treatment_required');
        } elseif ($orderCount >= 20) {
            $priorityClass = 'warning';
            $priorityText = translate('messages.premium_loyal');
            $priorityIcon = 'tio-star';
            $priorityBg = '#fff8e1';
            $priorityBorder = '#ffc107';
            $staffTip = translate('messages.staff_tip_premium_loyal');
            $urgencyBadge = translate('messages.high_priority');
        } elseif ($orderCount >= 10) {
            $priorityClass = 'success';
            $priorityText = translate('messages.regular_customer');
            $priorityIcon = 'tio-checkmark-circle';
            $priorityBg = '#e8f5e9';
            $priorityBorder = '#28a745';
            $staffTip = translate('messages.staff_tip_regular');
            $urgencyBadge = translate('messages.standard_priority');
        } elseif ($orderCount >= 5) {
            $priorityClass = 'info';
            $priorityText = translate('messages.active_customer');
            $priorityIcon = 'tio-trending-up';
            $priorityBg = '#e3f2fd';
            $priorityBorder = '#17a2b8';
            $staffTip = translate('messages.staff_tip_active');
            $urgencyBadge = translate('messages.important');
        } elseif ($orderCount >= 1) {
            $priorityClass = 'primary';
            $priorityText = translate('messages.returning_customer');
            $priorityIcon = 'tio-reload';
            $priorityBg = '#e7f3ff';
            $priorityBorder = '#377dff';
            $staffTip = translate('messages.staff_tip_returning');
            $urgencyBadge = translate('messages.make_it_better');
        } else {
            $priorityClass = 'warning';
            $priorityText = translate('messages.first_order');
            $priorityIcon = 'tio-sparkle';
            $priorityBg = '#fff3cd';
            $priorityBorder = '#ff9800';
            $staffTip = translate('messages.staff_tip_first_order');
            $urgencyBadge = translate('messages.critical_first_time');
        }
        
        $nextMilestone = $orderCount >= 20 ? 50 : ($orderCount >= 10 ? 20 : ($orderCount >= 5 ? 10 : 5));
        $remaining = $orderCount < 50 ? $nextMilestone - $orderCount : 0;

        // ========================================
        // SNOSCORE - Customer Behavior Rating
        // ========================================
        // Cancellation tracking (weighted)
        $customerCancels = $order->customer->customer_canceled_count ?? 0;
        $otherCancels = $order->customer->other_canceled_count ?? 0;
        $totalCancels = $customerCancels + $otherCancels;
        $refundCount = $order->customer->refund_count ?? 0;

        // Snoscore calculation (weighted approach)
        $totalOrders = $orderCount;
        $weightedCancels = ($customerCancels * 1.0) + ($otherCancels * 0.3);
        $cancelRate = $totalOrders > 0 ? $weightedCancels / $totalOrders : 0;
        $snoscore = round(max(1.0, min(5.0, 5 - ($cancelRate * 4))), 2);
        $cancellationRate = $totalOrders > 0 ? round(($totalCancels / $totalOrders) * 100, 1) : 0;

        // Status determination
        $snoscoreStatus = match(true) {
            $snoscore >= 4.5 => 'excellent',
            $snoscore >= 3.5 => 'good',
            $snoscore >= 2.5 => 'fair',
            $snoscore >= 1.5 => 'poor',
            default => 'risky',
        };

        // Star rating helper (for display)
        $fullStars = floor($snoscore);
        $halfStar = ($snoscore - $fullStars) >= 0.5;
        $emptyStars = 5 - $fullStars - ($halfStar ? 1 : 0);

        // Color coding based on snoscore status
        $snoscoreColor = match($snoscoreStatus) {
            'excellent' => 'success',
            'good' => 'info',
            'fair' => 'warning',
            'poor' => 'orange',
            'risky' => 'danger',
        };

        // Cancellation rate color (for display)
        $cancelRateColor = match(true) {
            $cancellationRate <= 5 => 'success',
            $cancellationRate <= 15 => 'warning',
            default => 'danger',
        };

        // Check if customer is risky
        $isRiskyCustomer = $snoscore < 2.5;
    @endphp

