<script>
(function() {
    'use strict';

    var tracking = {
        dm: {
            lat: parseFloat('{{ $order->dm_last_location["latitude"] ?? 0 }}'),
            lng: parseFloat('{{ $order->dm_last_location["longitude"] ?? 0 }}'),
            name: '{{ str_replace("'", "\\'", ($order->delivery_man->f_name ?? "") . " " . ($order->delivery_man->l_name ?? "")) }}',
            updated: '{{ $order->dm_last_location["updated_at"] ?? $order->dm_last_location["time"] ?? "" }}',
            // Speed tracking data
            prevLat: null,
            prevLng: null,
            prevTime: null,
            speed: 0,         // km/h
            state: 'unknown', // 'moving', 'idle', 'unknown'
            idleCount: 0,     // Count consecutive idle updates
            idleStartTime: null, // When idle state started
            // Distance trend tracking
            prevStoreDistance: null,
            prevCustomerDistance: null,
            storeHeading: null,    // 'approaching', 'moving_away', or null
            customerHeading: null, // 'approaching', 'moving_away', or null
            lastHeadingLat: null,
            lastHeadingLng: null,
            // Location duration tracking
            atStoreArrivalTime: null,   // When DM arrived at store
            atCustomerArrivalTime: null, // When DM arrived at customer
            isAtStore: false,
            isAtCustomer: false,
            proximityRadius: 0.1 // 100 meters in km
        },
        customer: {
            lat: parseFloat('{{ $customer_lat }}'),
            lng: parseFloat('{{ $customer_lng }}'),
            name: '{{ str_replace("'", "\\'", ($order->customer->f_name ?? "") . " " . ($order->customer->l_name ?? "")) }}',
            hasData: parseFloat('{{ $customer_lat }}') !== 0 && parseFloat('{{ $customer_lng }}') !== 0
        },
        store: {
            lat: parseFloat('{{ $store_lat }}'),
            lng: parseFloat('{{ $store_lng }}'),
            name: '{{ str_replace("'", "\\'", Str::limit($order->store->name ?? "Store", 20, "...")) }}',
            hasData: parseFloat('{{ $store_lat }}') !== 0 && parseFloat('{{ $store_lng }}') !== 0
        },
        orderStatus: '{{ $order->order_status }}'
    };

    // Calculate speed between two points
    function calculateSpeed(lat1, lng1, lat2, lng2, timeMs) {
        if (!lat1 || !lng1 || !lat2 || !lng2 || !timeMs || timeMs <= 0) return 0;

        var distanceKm = parseFloat(calculateDistance(lat1, lng1, lat2, lng2));
        var timeHours = timeMs / (1000 * 60 * 60); // Convert ms to hours

        if (timeHours <= 0) return 0;

        var speed = distanceKm / timeHours;

        // Cap unrealistic speeds (GPS glitches can cause jumps)
        if (speed > 120) speed = 0; // Ignore if > 120 km/h (likely GPS error)

        return speed;
    }

    // Determine state based on speed
    function getDeliveryState(speed, idleCount) {
        if (speed >= 5) {
            return { state: 'moving', label: 'Moving', class: 'success', icon: 'tio-run' };
        } else if (speed >= 1) {
            return { state: 'slow', label: 'Slow', class: 'warning', icon: 'tio-walk' };
        } else if (idleCount >= 3) {
            return { state: 'stopped', label: 'Stopped', class: 'danger', icon: 'tio-pause-circle' };
        } else {
            return { state: 'idle', label: 'Idle', class: 'secondary', icon: 'tio-pause' };
        }
    }

    // Format speed for display
    function formatSpeed(speedKmh) {
        if (speedKmh <= 0) return '0 km/h';
        if (speedKmh < 1) return (speedKmh * 1000).toFixed(0) + ' m/h';
        return speedKmh.toFixed(1) + ' km/h';
    }

    // Update speed and state UI
    function updateSpeedAndState() {
        var stateEl = document.getElementById('dmState');
        var speedEl = document.getElementById('dmSpeed');
        var stateIconEl = document.getElementById('dmStateIcon');
        var idleSinceContainer = document.getElementById('idleSinceContainer');
        var idleSinceEl = document.getElementById('idleSince');

        var stateInfo = getDeliveryState(tracking.dm.speed, tracking.dm.idleCount);

        if (stateEl) {
            stateEl.textContent = stateInfo.label;
            stateEl.className = 'badge badge-soft-' + stateInfo.class;
        }

        if (speedEl) {
            speedEl.textContent = formatSpeed(tracking.dm.speed);
            speedEl.className = tracking.dm.speed >= 5 ? 'text-success' :
                               (tracking.dm.speed >= 1 ? 'text-warning' : 'text-danger');
        }

        if (stateIconEl) {
            stateIconEl.className = stateInfo.icon + ' text-' + stateInfo.class;
        }

        // ✅ FIXED: Track idle time - improved detection
        var isIdle = (stateInfo.state === 'idle' || stateInfo.state === 'stopped' || stateInfo.state === 'slow' || tracking.dm.speed < 1);

        if (isIdle) {
            // Start tracking idle time if not already tracking
            if (!tracking.dm.idleStartTime) {
                tracking.dm.idleStartTime = new Date();
                console.log('🟡 Started tracking idle time');
            }
            var idleDuration = new Date() - tracking.dm.idleStartTime;

            if (idleSinceContainer && idleSinceEl) {
                // Always show when idle
                idleSinceContainer.style.display = 'block';
                idleSinceEl.textContent = formatDuration(idleDuration);

                // Color based on idle time
                if (idleDuration > 600000) { // > 10 min
                    idleSinceEl.className = 'text-danger font-weight-bold';
                } else if (idleDuration > 300000) { // > 5 min
                    idleSinceEl.className = 'text-warning font-weight-bold';
                } else {
                    idleSinceEl.className = 'text-secondary';
                }

                console.log('🟡 Idle time:', formatDuration(idleDuration), '- Speed:', tracking.dm.speed);
            }
        } else {
            // Moving - reset idle time
            if (tracking.dm.idleStartTime) {
                console.log('🟢 DM moving again - clearing idle time');
            }
            tracking.dm.idleStartTime = null;
            if (idleSinceContainer) {
                idleSinceContainer.style.display = 'none';
            }
        }
    }

    // Format duration for display (mm:ss or hh:mm:ss)
    function formatDuration(ms) {
        if (!ms || ms < 0) return '--';
        var seconds = Math.floor(ms / 1000);
        var minutes = Math.floor(seconds / 60);
        var hours = Math.floor(minutes / 60);

        seconds = seconds % 60;
        minutes = minutes % 60;

        if (hours > 0) {
            return hours + 'h ' + minutes + 'm';
        } else if (minutes > 0) {
            return minutes + 'm ' + seconds + 's';
        } else {
            return seconds + 's';
        }
    }

    // Check if DM is at store or customer location
    function checkLocationProximity() {
        var dmLat = tracking.dm.lat;
        var dmLng = tracking.dm.lng;
        var radius = tracking.dm.proximityRadius; // 100m
        var now = new Date();

        // Check proximity to store
        if (tracking.store.hasData) {
            var distToStore = parseFloat(calculateDistance(dmLat, dmLng, tracking.store.lat, tracking.store.lng));
            var wasAtStore = tracking.dm.isAtStore;
            tracking.dm.isAtStore = distToStore <= radius;

            if (tracking.dm.isAtStore && !wasAtStore) {
                // Just arrived at store
                tracking.dm.atStoreArrivalTime = now;
            } else if (!tracking.dm.isAtStore && wasAtStore) {
                // Left store
                tracking.dm.atStoreArrivalTime = null;
            }
        }

        // Check proximity to customer
        if (tracking.customer.hasData) {
            var distToCustomer = parseFloat(calculateDistance(dmLat, dmLng, tracking.customer.lat, tracking.customer.lng));
            var wasAtCustomer = tracking.dm.isAtCustomer;
            tracking.dm.isAtCustomer = distToCustomer <= radius;

            if (tracking.dm.isAtCustomer && !wasAtCustomer) {
                // Just arrived at customer
                tracking.dm.atCustomerArrivalTime = now;
            } else if (!tracking.dm.isAtCustomer && wasAtCustomer) {
                // Left customer
                tracking.dm.atCustomerArrivalTime = null;
            }
        }

        updateLocationDurationUI();
    }

    // Update location duration UI elements
    function updateLocationDurationUI() {
        var atStoreContainer = document.getElementById('atStoreContainer');
        var atStoreDuration = document.getElementById('atStoreDuration');
        var atCustomerContainer = document.getElementById('atCustomerContainer');
        var atCustomerDuration = document.getElementById('atCustomerDuration');
        var now = new Date();

        // Update store duration
        if (atStoreContainer && atStoreDuration) {
            if (tracking.dm.isAtStore && tracking.dm.atStoreArrivalTime) {
                var storeDuration = now - tracking.dm.atStoreArrivalTime;
                atStoreContainer.style.display = 'block';
                atStoreDuration.textContent = formatDuration(storeDuration);

                // Change color based on duration (warning if > 5 min, danger if > 10 min)
                if (storeDuration > 600000) { // > 10 min
                    atStoreDuration.className = 'badge badge-soft-danger';
                } else if (storeDuration > 300000) { // > 5 min
                    atStoreDuration.className = 'badge badge-soft-warning';
                } else {
                    atStoreDuration.className = 'badge badge-soft-primary';
                }
            } else {
                atStoreContainer.style.display = 'none';
            }
        }

        // Update customer duration
        if (atCustomerContainer && atCustomerDuration) {
            if (tracking.dm.isAtCustomer && tracking.dm.atCustomerArrivalTime) {
                var customerDuration = now - tracking.dm.atCustomerArrivalTime;
                atCustomerContainer.style.display = 'block';
                atCustomerDuration.textContent = formatDuration(customerDuration);

                // Change color based on duration (warning if > 3 min, danger if > 5 min)
                if (customerDuration > 300000) { // > 5 min
                    atCustomerDuration.className = 'badge badge-soft-danger';
                } else if (customerDuration > 180000) { // > 3 min
                    atCustomerDuration.className = 'badge badge-soft-warning';
                } else {
                    atCustomerDuration.className = 'badge badge-soft-success';
                }
            } else {
                atCustomerContainer.style.display = 'none';
            }
        }
    }

    // Update idle duration display
    function updateIdleDurationUI() {
        if (!tracking.dm.idleStartTime) return;

        var idleSinceContainer = document.getElementById('idleSinceContainer');
        var idleSinceEl = document.getElementById('idleSince');

        if (idleSinceContainer && idleSinceEl) {
            var idleDuration = new Date() - tracking.dm.idleStartTime;

            // Ensure container is visible
            idleSinceContainer.style.display = 'block';

            // Update idle time display
            idleSinceEl.textContent = formatDuration(idleDuration);

            // Color based on idle time
            if (idleDuration > 600000) { // > 10 min
                idleSinceEl.className = 'text-danger font-weight-bold';
            } else if (idleDuration > 300000) { // > 5 min
                idleSinceEl.className = 'text-warning font-weight-bold';
            } else {
                idleSinceEl.className = 'text-secondary';
            }
        }
    }

    // Start location duration timer (updates every second when at a location or idle)
    var locationDurationInterval = null;
    function startLocationDurationTimer() {
        if (locationDurationInterval) return;
        locationDurationInterval = setInterval(function() {
            // Update location duration (at store/customer)
            if (tracking.dm.isAtStore || tracking.dm.isAtCustomer) {
                updateLocationDurationUI();
            }
            // Update idle duration
            if (tracking.dm.idleStartTime) {
                updateIdleDurationUI();
            }
        }, 1000);
    }

    function calculateDistance(lat1, lng1, lat2, lng2) {
        var R = 6371;
        var dLat = (lat2 - lat1) * Math.PI / 180;
        var dLng = (lng2 - lng1) * Math.PI / 180;
        var a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
                Math.sin(dLng/2) * Math.sin(dLng/2);
        var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
        return (R * c).toFixed(2);
    }

    function formatDistance(km) {
        var meters = km * 1000;
        if (meters < 1000) {
            return Math.round(meters) + 'm';
        }
        return km + 'km';
    }

    function updateProgressRing(progress) {
        var circle = document.getElementById('progressCircle');
        if (circle) {
            var circumference = 2 * Math.PI * 45;
            var offset = circumference - (progress / 100) * circumference;
            circle.style.strokeDasharray = circumference;
            circle.style.strokeDashoffset = offset;
        }
    }

    function updateTracking() {
        var container = document.getElementById('deliveryTracking');
        var etaMinutes = document.getElementById('etaMinutes');
        var etaTimeValue = document.getElementById('etaTimeValue');
        var toStoreEl = document.getElementById('toStoreDistance');
        var toCustomerEl = document.getElementById('toCustomerDistance');
        var lastUpdateEl = document.getElementById('lastUpdateTime');
        var nearbyAlert = document.getElementById('nearbyAlert');
        var distanceSubtitle = document.getElementById('distanceToCustomer');

        if (!container) return;

        if (!tracking.dm.lat || !tracking.dm.lng) {
            container.innerHTML = '<div class="col-12"><div class="alert alert-light border text-center py-4"><i class="tio-gps-off h1 text-muted"></i><p class="mb-0 mt-2 text-muted">{{ translate("messages.delivery_man_location_not_available") }}</p></div></div>';
            return;
        }

        var html = '';
        var customerDistance = 0;
        var customerTime = 0;
        var customerNearby = false;
        var storeDistance = 0;
        var storeNearby = false;

        // Calculate store distance
        if (tracking.store.hasData) {
            storeDistance = parseFloat(calculateDistance(tracking.dm.lat, tracking.dm.lng, tracking.store.lat, tracking.store.lng));
            var storeMeters = storeDistance * 1000;
            storeNearby = storeMeters <= 400;

            if (toStoreEl) {
                toStoreEl.textContent = formatDistance(storeDistance);
                if (storeNearby) toStoreEl.classList.add('text-success', 'font-weight-bold');
            }

            html += '<div class="col-md-6 mb-3">';
            html += '<div class="distance-card ' + (storeNearby ? 'nearby' : '') + '" data-type="store">';
            html += '<div class="distance-card-icon store"><i class="tio-shop"></i></div>';
            html += '<div class="distance-card-content">';
            html += '<div class="distance-card-title">{{ translate("messages.to_store") }}</div>';
            html += '<div class="distance-card-name">' + tracking.store.name + '</div>';
            html += '</div>';
            html += '<div class="distance-card-value">';
            html += '<span class="distance-number">' + formatDistance(storeDistance) + '</span>';
            html += '<span class="distance-time">~' + Math.ceil(storeDistance * 3) + ' {{ translate("messages.min") }}</span>';

            // Update heading only when DM position actually changed
            var dmMoved = (tracking.dm.lastHeadingLat !== null &&
                          (tracking.dm.lastHeadingLat !== tracking.dm.lat || tracking.dm.lastHeadingLng !== tracking.dm.lng));
            if (dmMoved && tracking.dm.prevStoreDistance !== null) {
                var storeDiff = storeDistance - tracking.dm.prevStoreDistance;
                if (Math.abs(storeDiff) > 0.005) {
                    tracking.dm.storeHeading = storeDiff < 0 ? 'approaching' : 'moving_away';
                }
            }
            if (dmMoved) {
                tracking.dm.prevStoreDistance = storeDistance;
            } else if (tracking.dm.prevStoreDistance === null) {
                tracking.dm.prevStoreDistance = storeDistance;
            }

            // Show last known heading
            if (tracking.dm.storeHeading === 'approaching') {
                html += '<span class="heading-indicator approaching"><i class="tio-trending-down"></i> {{ translate("messages.approaching") }}</span>';
            } else if (tracking.dm.storeHeading === 'moving_away') {
                html += '<span class="heading-indicator moving-away"><i class="tio-trending-up"></i> {{ translate("messages.moving_away") }}</span>';
            }
            html += '</div>';
            if (storeNearby) {
                html += '<div class="nearby-badge"><i class="tio-checkmark-circle"></i> {{ translate("messages.at_store") }}</div>';
            }
            html += '</div></div>';
        }

        // Calculate customer distance
        if (tracking.customer.hasData) {
            customerDistance = parseFloat(calculateDistance(tracking.dm.lat, tracking.dm.lng, tracking.customer.lat, tracking.customer.lng));
            var custMeters = customerDistance * 1000;
            customerTime = Math.ceil(customerDistance * 3);
            customerNearby = custMeters <= 500;

            if (toCustomerEl) {
                toCustomerEl.textContent = formatDistance(customerDistance);
                if (customerNearby) toCustomerEl.classList.add('text-success', 'font-weight-bold');
            }

            if (distanceSubtitle) {
                distanceSubtitle.textContent = formatDistance(customerDistance) + ' {{ translate("messages.away") }}';
            }

            html += '<div class="col-md-6 mb-3">';
            html += '<div class="distance-card ' + (customerNearby ? 'nearby customer-nearby' : '') + '" data-type="customer">';
            html += '<div class="distance-card-icon customer"><i class="tio-user"></i></div>';
            html += '<div class="distance-card-content">';
            html += '<div class="distance-card-title">{{ translate("messages.to_customer") }}</div>';
            html += '<div class="distance-card-name">' + tracking.customer.name + '</div>';
            html += '</div>';
            html += '<div class="distance-card-value">';
            html += '<span class="distance-number">' + formatDistance(customerDistance) + '</span>';
            html += '<span class="distance-time">~' + customerTime + ' {{ translate("messages.min") }}</span>';

            // Update heading only when DM position actually changed
            var dmMovedCust = (tracking.dm.lastHeadingLat !== null &&
                              (tracking.dm.lastHeadingLat !== tracking.dm.lat || tracking.dm.lastHeadingLng !== tracking.dm.lng));
            if (dmMovedCust && tracking.dm.prevCustomerDistance !== null) {
                var custDiff = customerDistance - tracking.dm.prevCustomerDistance;
                if (Math.abs(custDiff) > 0.005) {
                    tracking.dm.customerHeading = custDiff < 0 ? 'approaching' : 'moving_away';
                }
            }
            if (dmMovedCust) {
                tracking.dm.prevCustomerDistance = customerDistance;
            } else if (tracking.dm.prevCustomerDistance === null) {
                tracking.dm.prevCustomerDistance = customerDistance;
            }

            // Show last known heading
            if (tracking.dm.customerHeading === 'approaching') {
                html += '<span class="heading-indicator approaching"><i class="tio-trending-down"></i> {{ translate("messages.approaching") }}</span>';
            } else if (tracking.dm.customerHeading === 'moving_away') {
                html += '<span class="heading-indicator moving-away"><i class="tio-trending-up"></i> {{ translate("messages.moving_away") }}</span>';
            }
            html += '</div>';
            if (customerNearby) {
                html += '<div class="nearby-badge"><i class="tio-checkmark-circle"></i> {{ translate("messages.nearby") }}!</div>';
            }
            html += '</div></div>';

            // Update ETA display
            if (etaMinutes) {
                etaMinutes.textContent = customerNearby ? '< 3' : customerTime;
            }

            if (etaTimeValue) {
                var now = new Date();
                var eta = new Date(now.getTime() + (customerTime * 60000));
                var hours = eta.getHours();
                var mins = eta.getMinutes();
                var ampm = hours >= 12 ? 'PM' : 'AM';
                hours = hours % 12 || 12;
                mins = mins < 10 ? '0' + mins : mins;
                etaTimeValue.textContent = customerNearby ? '{{ translate("messages.arriving_now") }}!' : hours + ':' + mins + ' ' + ampm;
            }

            // Update progress ring (inverse - less distance = more progress)
            var maxDistance = 10; // assume 10km as max for progress calc
            var progress = Math.min(100, Math.max(0, ((maxDistance - customerDistance) / maxDistance) * 100));
            updateProgressRing(progress);

            // Show/hide nearby alert
            if (nearbyAlert) {
                nearbyAlert.style.display = customerNearby ? 'block' : 'none';
            }

            // Update ETA hero style based on proximity
            var etaHero = document.getElementById('etaHeroSection');
            if (etaHero) {
                etaHero.classList.remove('eta-nearby', 'eta-close', 'eta-far');
                if (customerNearby) {
                    etaHero.classList.add('eta-nearby');
                } else if (customerDistance <= 2) {
                    etaHero.classList.add('eta-close');
                } else {
                    etaHero.classList.add('eta-far');
                }
            }
        }

        // Track DM position for heading comparison
        tracking.dm.lastHeadingLat = tracking.dm.lat;
        tracking.dm.lastHeadingLng = tracking.dm.lng;

        // Last update time
        if (tracking.dm.updated && lastUpdateEl) {
            var lastUpdate = new Date(tracking.dm.updated);
            var now = new Date();
            var diffMin = Math.floor((now - lastUpdate) / 1000 / 60);
            var timeAgo = diffMin < 1 ? '{{ translate("messages.now") }}' :
                          diffMin < 60 ? diffMin + '{{ translate("messages.m_ago") }}' :
                          Math.floor(diffMin / 60) + '{{ translate("messages.h_ago") }}';
            lastUpdateEl.textContent = timeAgo;
        }

        if (html === '') {
            html = '<div class="col-12"><div class="alert alert-light border text-center py-4"><i class="tio-info h1 text-muted"></i><p class="mb-0 mt-2 text-muted">{{ translate("messages.location_data_not_available") }}</p></div></div>';
        }

        container.innerHTML = html;

        // Update speed and state display
        updateSpeedAndState();

        // Check location proximity (at store/customer)
        checkLocationProximity();

    }

    // Make function globally available for real-time updates
    window.updateDeliveryTracking = updateTracking;
    window.deliveryTrackingData = tracking;

    // Load saved tracking stats from database
    function loadSavedTrackingStats() {
        var orderId = '{{ $order->id }}';
        $.ajax({
            url: '{{ route("admin.order.tracking-stats", ":id") }}'.replace(':id', orderId),
            type: 'GET',
            success: function(response) {
                if (response.success && response.stats) {
                    var stats = response.stats;
                    console.log('📥 Loaded tracking stats from DB:', stats);

                    // Restore state flags
                    tracking.dm.isAtStore = stats.is_at_store;
                    tracking.dm.isAtCustomer = stats.is_at_customer;
                    tracking.dm.speed = parseFloat(stats.last_speed) || 0;
                    tracking.dm.state = stats.movement_state || 'unknown';

                    // Restore arrival times (convert ISO string to Date)
                    if (stats.is_at_store && stats.store_arrival_time) {
                        tracking.dm.atStoreArrivalTime = new Date(stats.store_arrival_time);
                    }
                    if (stats.is_at_customer && stats.customer_arrival_time) {
                        tracking.dm.atCustomerArrivalTime = new Date(stats.customer_arrival_time);
                    }

                    // ✅ FIXED: Load idle time from DB and force display
                    if (stats.is_idle && stats.idle_start_time) {
                        tracking.dm.idleStartTime = new Date(stats.idle_start_time);
                        console.log('🟡 Restored idle time from DB:', stats.idle_start_time);

                        // Force show idle time immediately
                        var idleSinceContainer = document.getElementById('idleSinceContainer');
                        if (idleSinceContainer) {
                            idleSinceContainer.style.display = 'block';
                        }
                    }

                    // Update UI with saved data
                    updateSpeedAndState();
                    updateLocationDurationUI();
                    updateIdleDurationUI(); // ✅ Added: Ensure idle time shows

                    console.log('✅ UI updated with saved tracking stats');
                }
            },
            error: function(xhr, status, error) {
                console.error('❌ Failed to load tracking stats:', error);
            }
        });
    }

    // Initial update
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', function() {
            loadSavedTrackingStats(); // Load saved stats first
            updateTracking();
            startLocationDurationTimer();
        });
    } else {
        loadSavedTrackingStats(); // Load saved stats first
        updateTracking();
        startLocationDurationTimer();
    }

    // Auto-refresh every 30 seconds
    setInterval(updateTracking, 30000);
})();

function focusOnDeliveryMan() {
    // Trigger map modal and center on delivery man
    $('#locationModal').modal('show');
}
</script>

<style>
/* Delivery Tracking Card Styles */
.delivery-tracking-card {
    overflow: hidden;
}

.delivery-tracking-card .card-header {
    padding: 1.25rem;
}

.tracking-icon-wrapper {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-size: 1.5rem;
}

/* ETA Hero Section */
.eta-hero {
    background: linear-gradient(135deg, #f5f7fa 0%, #e4e8f0 100%);
    border-radius: 16px;
    padding: 1.5rem;
    transition: all 0.3s ease;
}

.eta-hero.eta-nearby {
    background: linear-gradient(135deg, #d4edda 0%, #c3e6cb 100%);
}

.eta-hero.eta-close {
    background: linear-gradient(135deg, #cce5ff 0%, #b8daff 100%);
}

.eta-hero-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.eta-time-display {
    display: flex;
    flex-direction: column;
}

.eta-label {
    font-size: 0.875rem;
    color: #6c757d;
    margin-bottom: 0.25rem;
}

.eta-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: #1e2022;
}

.eta-nearby .eta-value {
    color: #28a745;
}

.eta-progress-ring {
    position: relative;
    width: 80px;
    height: 80px;
}

.eta-progress-ring svg {
    transform: rotate(-90deg);
    width: 100%;
    height: 100%;
}

.progress-ring-bg {
    fill: none;
    stroke: #e9ecef;
    stroke-width: 8;
}

.progress-ring-fill {
    fill: none;
    stroke: #667eea;
    stroke-width: 8;
    stroke-linecap: round;
    stroke-dasharray: 283;
    stroke-dashoffset: 283;
    transition: stroke-dashoffset 0.5s ease;
}

.eta-nearby .progress-ring-fill {
    stroke: #28a745;
}

.eta-minutes {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    line-height: 1;
}

.eta-minutes span {
    font-size: 1.5rem;
    font-weight: 700;
    display: block;
}

.eta-minutes small {
    font-size: 0.75rem;
    color: #6c757d;
}

/* Delivery Timeline */
.delivery-timeline {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: 0 1rem;
    position: relative;
}

.timeline-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 0 0 auto;
    position: relative;
    z-index: 1;
}

.timeline-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: #e9ecef;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    color: #adb5bd;
    margin-bottom: 0.5rem;
    transition: all 0.3s ease;
    border: 3px solid #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.timeline-step.completed .timeline-icon {
    background: #28a745;
    color: #fff;
}

.timeline-step.active .timeline-icon {
    background: #007bff;
    color: #fff;
    animation: pulse-icon 2s infinite;
}

@keyframes pulse-icon {
    0%, 100% { box-shadow: 0 0 0 0 rgba(0, 123, 255, 0.4); }
    50% { box-shadow: 0 0 0 10px rgba(0, 123, 255, 0); }
}

.timeline-content {
    text-align: center;
}

.timeline-title {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: #1e2022;
}

.timeline-subtitle {
    display: block;
    font-size: 0.625rem;
    color: #6c757d;
}

.timeline-connector {
    flex: 1;
    height: 3px;
    background: #e9ecef;
    margin-top: 20px;
    position: relative;
}

.timeline-step.completed + .timeline-connector {
    background: #28a745;
}

/* Distance Cards */
.distance-card {
    display: flex;
    align-items: center;
    background: #fff;
    border: 1px solid #e9ecef;
    border-radius: 12px;
    padding: 1rem;
    position: relative;
    transition: all 0.3s ease;
    overflow: hidden;
}

.distance-card:hover {
    box-shadow: 0 4px 15px rgba(0,0,0,0.1);
    transform: translateY(-2px);
}

.distance-card.nearby {
    border-color: #28a745;
    background: linear-gradient(135deg, #f8fff9 0%, #e8f5e9 100%);
}

.distance-card.customer-nearby {
    animation: glow-green 2s infinite;
}

@keyframes glow-green {
    0%, 100% { box-shadow: 0 0 5px rgba(40, 167, 69, 0.3); }
    50% { box-shadow: 0 0 20px rgba(40, 167, 69, 0.5); }
}

.distance-card-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    margin-right: 1rem;
    flex-shrink: 0;
}

.distance-card-icon.store {
    background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
    color: #e65c00;
}

.distance-card-icon.customer {
    background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
    color: #00b09b;
}

.distance-card-content {
    flex: 1;
    min-width: 0;
}

.distance-card-title {
    font-size: 0.75rem;
    color: #6c757d;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.distance-card-name {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1e2022;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.distance-card-value {
    text-align: right;
    flex-shrink: 0;
}

.distance-number {
    display: block;
    font-size: 1.25rem;
    font-weight: 700;
    color: #1e2022;
}

.heading-indicator {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    margin-top: 2px;
}

.heading-indicator.approaching {
    color: #28a745;
}

.heading-indicator.moving-away {
    color: #dc3545;
}

.distance-time {
    display: block;
    font-size: 0.75rem;
    color: #6c757d;
}

.nearby-badge {
    position: absolute;
    top: 0;
    right: 0;
    background: #28a745;
    color: #fff;
    font-size: 0.625rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0 12px 0 8px;
    font-weight: 600;
}

/* Delivery Man Card */
.delivery-man-card {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 1rem;
}

.dm-avatar {
    position: relative;
    width: 50px;
    height: 50px;
    margin-right: 1rem;
}

.dm-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #fff;
    box-shadow: 0 2px 8px rgba(0,0,0,0.1);
}

.dm-status-dot {
    position: absolute;
    bottom: 2px;
    right: 2px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid #fff;
}

.dm-status-dot.online {
    background: #28a745;
}

.dm-info h6 {
    font-size: 1rem;
}

.btn-icon {
    width: 36px;
    height: 36px;
    padding: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
}

.location-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.location-stat i {
    font-size: 1rem;
    margin-bottom: 0.25rem;
}

.location-stat span {
    font-size: 1rem;
    font-weight: 600;
}

.location-stat small {
    font-size: 0.625rem;
    color: #6c757d;
    text-transform: uppercase;
}

/* Speed and State Display */
#dmState {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    transition: all 0.3s ease;
}

#dmSpeed {
    font-size: 1rem;
    font-weight: 700;
    transition: color 0.3s ease;
}

#dmStateIcon {
    font-size: 1.2rem;
    transition: all 0.3s ease;
}

/* State-specific animations */
.tio-run {
    animation: moveIcon 0.5s infinite alternate;
}

.tio-walk {
    animation: walkIcon 0.8s infinite alternate;
}

.tio-pause-circle {
    animation: pulseIcon 1.5s infinite;
}

@keyframes moveIcon {
    from { transform: translateX(-2px); }
    to { transform: translateX(2px); }
}

@keyframes walkIcon {
    from { transform: translateY(0); }
    to { transform: translateY(-2px); }
}

@keyframes pulseIcon {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
}

/* Nearby Alert */
.nearby-alert {
    background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
    border-radius: 12px;
    padding: 1rem;
    color: #fff;
}

.nearby-alert-content {
    display: flex;
    align-items: center;
}

.nearby-icon {
    width: 50px;
    height: 50px;
    background: rgba(255,255,255,0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin-right: 1rem;
}

.pulse-ring {
