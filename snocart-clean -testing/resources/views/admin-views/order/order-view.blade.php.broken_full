<script>
(function() {
    'use strict';

    var deliveryManId = {{ $order->delivery_man->id }};
    var orderId = {{ $order->id }};
    var pusherKey = "{{ env('PUSHER_APP_KEY', '') }}";
    var pusherHost = "{{ env('PUSHER_HOST', '') }}" || window.location.hostname;
    var pusherPort = {{ env('PUSHER_PORT', 6001) }};
    var pusherCluster = "{{ env('PUSHER_APP_CLUSTER', 'mt1') }}";
    var useTLS = "{{ env('PUSHER_SCHEME', 'https') }}" === 'https';

    // Store for tracking data updates
    window.liveTrackingData = {
        lat: {{ $order->dm_last_location['latitude'] ?? 0 }},
        lng: {{ $order->dm_last_location['longitude'] ?? 0 }},
        lastUpdate: new Date()
    };

    // Update indicator to show connecting state
    showRealTimeIndicator('connecting');

    if (!pusherKey) {
        console.warn('⚠️ Pusher not configured, real-time tracking disabled');
        showRealTimeIndicator('offline');
        return;
    }

    try {
        var trackingPusher = new Pusher(pusherKey, {
            cluster: pusherCluster,
            wsHost: pusherHost,
            wsPort: pusherPort,
            wssPort: pusherPort,
            forceTLS: useTLS,
            enabledTransports: ['ws', 'wss'],
            disableStats: true
        });

        var channel = trackingPusher.subscribe('delivery-man.' + deliveryManId);

        channel.bind('pusher:subscription_succeeded', function() {
            showRealTimeIndicator('live');
        });

        channel.bind('pusher:subscription_error', function(error) {
            console.error('❌ Failed to subscribe to location channel:', error);
            showRealTimeIndicator('offline');
        });

        channel.bind('location.updated', function(data) {
            if (data.location && data.location.latitude && data.location.longitude) {
                updateDeliveryManLocationRealtime(data.location);
            }
        });

        trackingPusher.connection.bind('connected', function() {
            showRealTimeIndicator('live');
        });

        trackingPusher.connection.bind('disconnected', function() {
            showRealTimeIndicator('offline');
        });

        trackingPusher.connection.bind('error', function(error) {
            console.error('🔌 WebSocket error:', error);
            showRealTimeIndicator('offline');
        });

    } catch (e) {
        console.error('❌ Failed to initialize real-time tracking:', e);
        showRealTimeIndicator('offline');
    }

    function updateDeliveryManLocationRealtime(location) {
        var newLat = parseFloat(location.latitude);
        var newLng = parseFloat(location.longitude);
        var currentTime = new Date();

        // Calculate speed if we have previous location
        if (window.deliveryTrackingData && window.deliveryTrackingData.dm.prevLat !== null) {
            var prevLat = window.deliveryTrackingData.dm.prevLat;
            var prevLng = window.deliveryTrackingData.dm.prevLng;
            var prevTime = window.deliveryTrackingData.dm.prevTime;

            if (prevTime) {
                var timeDiff = currentTime - prevTime; // in ms

                // Calculate distance using Haversine
                var R = 6371; // Earth radius in km
                var dLat = (newLat - prevLat) * Math.PI / 180;
                var dLng = (newLng - prevLng) * Math.PI / 180;
                var a = Math.sin(dLat/2) * Math.sin(dLat/2) +
                        Math.cos(prevLat * Math.PI / 180) * Math.cos(newLat * Math.PI / 180) *
                        Math.sin(dLng/2) * Math.sin(dLng/2);
                var c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
                var distanceKm = R * c;

                // Calculate speed (km/h)
                var timeHours = timeDiff / (1000 * 60 * 60);
                var speed = timeHours > 0 ? distanceKm / timeHours : 0;

                // Filter out GPS glitches (unrealistic speeds)
                if (speed > 120) speed = window.deliveryTrackingData.dm.speed || 0;

                // Smooth speed with previous value (moving average)
                var prevSpeed = window.deliveryTrackingData.dm.speed || 0;
                speed = (speed + prevSpeed) / 2;

                window.deliveryTrackingData.dm.speed = speed;

                // Update idle counter
                if (speed < 1) {
                    window.deliveryTrackingData.dm.idleCount = (window.deliveryTrackingData.dm.idleCount || 0) + 1;
                } else {
                    window.deliveryTrackingData.dm.idleCount = 0;
                }

                // Determine state
                if (speed >= 5) {
                    window.deliveryTrackingData.dm.state = 'moving';
                } else if (speed >= 1) {
                    window.deliveryTrackingData.dm.state = 'slow';
                } else if (window.deliveryTrackingData.dm.idleCount >= 3) {
                    window.deliveryTrackingData.dm.state = 'stopped';
                } else {
                    window.deliveryTrackingData.dm.state = 'idle';
                }

            }
        }

        // Store new location
        window.liveTrackingData.lat = newLat;
        window.liveTrackingData.lng = newLng;
        window.liveTrackingData.lastUpdate = currentTime;

        // Update map marker if visible
        if (window.dmMarkerOnMap && typeof google !== 'undefined') {
            var newPosition = new google.maps.LatLng(newLat, newLng);
            window.dmMarkerOnMap.setPosition(newPosition);
        }

        // Update the global tracking data and refresh UI
        if (window.deliveryTrackingData) {
            // Store previous location for next speed calculation
            window.deliveryTrackingData.dm.prevLat = window.deliveryTrackingData.dm.lat;
            window.deliveryTrackingData.dm.prevLng = window.deliveryTrackingData.dm.lng;
            window.deliveryTrackingData.dm.prevTime = currentTime;

            // Update current location
            window.deliveryTrackingData.dm.lat = newLat;
            window.deliveryTrackingData.dm.lng = newLng;
            window.deliveryTrackingData.dm.updated = currentTime.toISOString();
        }

        // Trigger UI update
        if (typeof window.updateDeliveryTracking === 'function') {
            window.updateDeliveryTracking();
        }

        // Update last update time to "Now"
        var lastUpdateEl = document.getElementById('lastUpdateTime');
        if (lastUpdateEl) {
            lastUpdateEl.textContent = 'Now';
            lastUpdateEl.classList.add('text-success');
            setTimeout(function() {
                lastUpdateEl.classList.remove('text-success');
            }, 3000);
        }

        // Flash the tracking card
        flashTrackingCard();
    }

    function showRealTimeIndicator(status) {
        var indicator = document.getElementById('realTimeIndicator');
        if (!indicator) return;

        var configs = {
            'live': {
                className: 'badge badge-soft-success',
                html: '<span class="live-dot"></span> LIVE'
            },
            'connecting': {
                className: 'badge badge-soft-warning',
                html: '<span class="live-dot" style="animation:none;background:#ffc107;"></span> Connecting...'
            },
            'offline': {
                className: 'badge badge-soft-secondary',
                html: '<span class="live-dot" style="animation:none;background:#6c757d;"></span> Offline'
            }
        };

        var config = configs[status] || configs['offline'];
        indicator.className = config.className;
        indicator.innerHTML = config.html;
    }

    function flashTrackingCard() {
        var card = document.querySelector('.delivery-tracking-card');
        if (card) {
            card.classList.add('flash-update');
            setTimeout(function() {
                card.classList.remove('flash-update');
            }, 1000);
        }

        // Also flash the distance cards
        var distanceCards = document.querySelectorAll('.distance-card');
        distanceCards.forEach(function(dc) {
            dc.classList.add('distance-card-updated');
            setTimeout(function() {
                dc.classList.remove('distance-card-updated');
            }, 1000);
        });
    }
})();
</script>

{{-- Real-time Item Pickup Updates --}}
<script>
(function() {
    'use strict';

    var orderId = {{ $order->id }};
    var pusherKey = '{{ env("PUSHER_APP_KEY") }}';
    var pusherCluster = '{{ env("PUSHER_APP_CLUSTER", "ap2") }}';
    var pusherHost = '{{ env("PUSHER_HOST", "") }}';
    var pusherPort = {{ env("PUSHER_PORT", 443) }};
    var useTLS = {{ env("PUSHER_USE_TLS", "true") === "true" ? "true" : "false" }};

    if (!pusherKey) {
        console.warn('⚠️ Pusher not configured, real-time item pickup updates disabled');
        return;
    }

    try {
        // Initialize Pusher for item updates (self-hosted WebSocket server)
        var itemPusher = new Pusher(pusherKey, {
            cluster: pusherCluster,
            wsHost: pusherHost,
            wsPort: pusherPort,
            wssPort: pusherPort,
            forceTLS: useTLS,
            enabledTransports: ['ws', 'wss'],
            encrypted: true,
            disableStats: true
        });

        // Subscribe to order-specific channel
        var orderChannel = itemPusher.subscribe('order.' + orderId);

        orderChannel.bind('pusher:subscription_succeeded', function() {
            console.log('✅ Subscribed to order item updates');
        });

        // Listen for item pickup events
        orderChannel.bind('item.pickup.updated', function(data) {
            console.log('📦 Item pickup status updated:', data);
            updateItemPickupStatus(data);
        });

        orderChannel.bind('pusher:subscription_error', function(error) {
            console.error('❌ Failed to subscribe to order channel:', error);
        });

    } catch (e) {
        console.error('❌ Failed to initialize item pickup tracking:', e);
    }

    // Update UI when item pickup status changes
    function updateItemPickupStatus(data) {
        console.log('🔄 Updating pickup status for detail ID:', data.order_detail_id);

        var orderDetailId = data.order_detail_id;
        var isPickedUp = data.is_picked_up;
        var pickedUpAt = data.picked_up_at;

        // Find the item row using data attribute
        var itemRow = $('tr[data-order-detail-id="' + orderDetailId + '"]');

        console.log('🔍 Found rows:', itemRow.length);

        if (itemRow.length > 0) {
            // Find the container div that has the item name
            var itemNameContainer = itemRow.find('.line--limit-1').first().parent();

            console.log('📍 Found item name container:', itemNameContainer.length);

            if (isPickedUp) {
                // Remove existing pickup badge if any
                itemNameContainer.find('.badge-pickup-realtime').remove();

                // Add pickup badge after the strong tag
                var pickupBadge = '<span class="badge badge-success ml-1 badge-pickup-realtime" title="Picked up at ' + pickedUpAt + '" style="background: linear-gradient(135deg, #28a745 0%, #20c997 100%); box-shadow: 0 2px 4px rgba(40, 167, 69, 0.3);">' +
                                 '<i class="tio-checkmark-circle-outlined"></i> {{ translate("messages.picked_up") }}</span>';

                itemRow.find('.line--limit-1').first().after(pickupBadge);

                // Flash animation
                itemRow.addClass('pickup-updated-flash');
                setTimeout(function() {
                    itemRow.removeClass('pickup-updated-flash');
                }, 2000);

                console.log('✅ Badge added successfully');

                // Show toast notification
                if (typeof toastr !== 'undefined') {
                    toastr.success('Item marked as picked up!', '', {
                        timeOut: 3000,
                        closeButton: true,
                        progressBar: true
                    });
                }
            } else {
                // Remove pickup badge
                itemRow.find('.badge-pickup-realtime').remove();
                console.log('❌ Badge removed');
            }
        } else {
            console.error('⚠️ Could not find order detail row for ID:', orderDetailId);
            console.log('📋 Available rows:', $('tr[data-order-detail-id]').map(function() {
                return $(this).data('order-detail-id');
            }).get());

            // Fallback: refresh the page to show updates
            console.log('🔄 Reloading page in 1 second...');
            setTimeout(function() {
                location.reload();
            }, 1000);
        }
    }

    // 🧪 Test function - accessible from browser console
    window.testItemPickupUpdate = function(orderDetailId) {
        if (!orderDetailId) {
            var firstRow = $('tr[data-order-detail-id]').first();
            orderDetailId = firstRow.data('order-detail-id');
            console.log('📝 Using first order detail ID:', orderDetailId);
        }

        var testData = {
            order_id: {{ $order->id }},
            order_detail_id: orderDetailId,
            is_picked_up: true,
            picked_up_at: new Date().toLocaleTimeString()
        };

        console.log('🧪 Testing pickup update with data:', testData);
        updateItemPickupStatus(testData);
    };

    // Log available order detail IDs on page load
    console.log('📋 Order Detail IDs on this page:',
        $('tr[data-order-detail-id]').map(function() {
            return $(this).data('order-detail-id');
        }).get()
    );
})();
</script>

<style>
/* Real-time tracking enhanced styles */
/* Pickup flash animation */
@keyframes pickupFlash {
    0%, 100% { background-color: transparent; }
    50% { background-color: rgba(40, 167, 69, 0.1); }
}
.pickup-updated-flash {
    animation: pickupFlash 0.6s ease-in-out 3;
}

@keyframes flashUpdate {
    0%, 100% { box-shadow: 0 0 0 rgba(102, 126, 234, 0); }
    50% { box-shadow: 0 0 25px rgba(102, 126, 234, 0.4); }
}

.flash-update {
    animation: flashUpdate 0.5s ease-in-out 2;
}

.distance-card-updated {
    animation: cardPulse 0.5s ease-in-out;
}

@keyframes cardPulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.02); }
}
</style>
