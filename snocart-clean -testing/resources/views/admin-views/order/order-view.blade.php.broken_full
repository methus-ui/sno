// ============================================
// UPDATED: Show Replacement Suggestions with "Keep This Item" option
// ============================================

function showReplacementSuggestions(outOfStockItem, replacements, orderDetailId) {
    // Remove any previous suggestion items and banners
    $('.suggestion-item-card, .suggestion-banner').remove();

    let grid = $('#items');
    if (!grid.length) return;

    // Add a banner above the grid
    let bannerHTML = `
        <div class="suggestion-banner" data-old-item-id="${outOfStockItem.id}" data-order-detail-id="${orderDetailId}" style="grid-column: 1 / -1; background: linear-gradient(135deg, #e8f5e9, #f1f8e9); border: 2px solid #66bb6a; border-radius: 10px; padding: 12px 16px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
            <div class="d-flex align-items-center">
                <img src="${outOfStockItem.image_full_url}" style="width:40px;height:40px;object-fit:contain;border-radius:6px;margin-right:10px;background:#fff;" onerror="this.src='{{ asset('public/assets/admin/img/160x160/img2.jpg') }}'">
                <div>
                    <strong style="font-size:0.9rem;">🔄 {{ translate('messages.suggestions_for') }}: ${outOfStockItem.name}</strong>
                    <small class="d-block text-muted">${replacements.length} similar item${replacements.length > 1 ? 's' : ''} found</small>
                </div>
            </div>
            <button type="button" class="btn btn-sm btn-outline-secondary clear-suggestions">
                <i class="tio-clear"></i> {{ translate('messages.clear') }}
            </button>
        </div>`;

    // Build suggestion cards using the same modern-item-card style
    let cardsHTML = '';
    replacements.forEach(function(item) {
        let priceDiff = '';
        if (item.price_difference !== 0) {
            let abs = Math.abs(item.price_difference).toFixed(2);
            if (item.price_difference < 0) {
                priceDiff = `<span class="badge badge-soft-success" style="font-size:.65rem;"><i class="tio-trending-down"></i> {{ \App\CentralLogics\Helpers::currency_symbol() }}${abs} cheaper</span>`;
            } else {
                priceDiff = `<span class="badge badge-soft-danger" style="font-size:.65rem;"><i class="tio-trending-up"></i> {{ \App\CentralLogics\Helpers::currency_symbol() }}${abs} more</span>`;
            }
        }

        // Match score color
        let scoreColor = item.similarity_score >= 60 ? '#28a745' : (item.similarity_score >= 35 ? '#ffc107' : '#6c757d');
        let scoreBorderColor = item.similarity_score >= 60 ? '#66bb6a' : (item.similarity_score >= 35 ? '#ffe082' : '#dee2e6');

        // Store badge
        let storeBadge = '';
        if (item.same_store) {
            storeBadge = `<span class="badge badge-soft-primary" style="font-size:.6rem;"><i class="tio-store"></i> Same Store</span>`;
        } else if (item.store_name) {
            storeBadge = `<span class="badge badge-soft-warning" style="font-size:.6rem;"><i class="tio-store"></i> ${item.store_name}</span>`;
        }

        // Rating
        let ratingHTML = '';
        if (item.avg_rating && item.avg_rating > 0) {
            ratingHTML = `<small class="text-warning"><i class="tio-star"></i> ${parseFloat(item.avg_rating).toFixed(1)}</small>`;
        }

        // Discount
        let discountHTML = '';
        if (item.discount && item.discount > 0) {
            let discText = item.discount_type === 'percent' ? item.discount + '% OFF' : '{{ \App\CentralLogics\Helpers::currency_symbol() }}' + item.discount + ' OFF';
            discountHTML = `<span class="badge badge-soft-danger" style="font-size:.6rem;"><i class="tio-offer"></i> ${discText}</span>`;
        }

        cardsHTML += `
            <div class="modern-item-card suggestion-item-card" style="border-color:${scoreBorderColor};">
                <div class="item-image-wrapper">
                    <img class="w-100" src="${item.image_full_url}" onerror="this.src='{{ asset('public/assets/admin/img/160x160/img2.jpg') }}'" alt="${item.name}">
                    <span class="quick-edit-badge" style="opacity:1;background:${scoreColor};">${item.similarity_score}% Match</span>
                </div>
                <div class="item-info-section">
                    <div class="d-flex align-items-center gap-1 flex-wrap mb-1" style="gap:4px;">
                        ${storeBadge}
                        ${item.category_match ? '<span class="badge badge-soft-info" style="font-size:.6rem;"><i class="tio-checkmark"></i> Same Category</span>' : ''}
                        ${ratingHTML}
                    </div>
                    <h6 class="item-name" title="${item.name}">${item.name}</h6>
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <div class="price-tag">
                            <i class="tio-money mr-1"></i>
                            {{ \App\CentralLogics\Helpers::currency_symbol() }}${item.price}
                            ${item.unit ? '<span style="font-size:.85rem;opacity:.9;"> / ' + (typeof item.unit === 'object' ? item.unit.unit : item.unit) + '</span>' : ''}
                        </div>
                    </div>
                    <div class="d-flex flex-wrap mb-1" style="gap:4px;">
                        ${priceDiff}
                        ${discountHTML}
                    </div>
                    ${item.stock ? '<small class="d-block text-success mb-1"><i class="tio-checkmark-circle"></i> ' + item.stock + ' in stock</small>' : ''}
                    <button type="button" class="add-item-btn quick-view" data-product-id="${item.id}" style="margin-top:4px;">
                        <i class="tio-add-circle-outlined mr-1"></i> {{ translate('messages.add_to_order') }}
                    </button>
                </div>
            </div>`;
    });

    // Prepend banner + cards to the grid
    grid.prepend(cardsHTML);
    grid.prepend(bannerHTML);

    // Scroll to the grid
    $('html, body').animate({
        scrollTop: grid.offset().top - 80
    }, 400);
}

// Clear suggestions
$(document).on('click', '.clear-suggestions', function() {
    $('.suggestion-item-card, .suggestion-banner').fadeOut(200, function() { $(this).remove(); });
});

