    <script>
        $(document).ready(function() {
            // Toggle password visibility
            $('.toggle-password').on('click', function() {
                var input = $(this).siblings('input');
                var icon = $(this).find('i');
                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    icon.removeClass('tio-visible-outlined').addClass('tio-hidden-outlined');
                } else {
                    input.attr('type', 'password');
                    icon.removeClass('tio-hidden-outlined').addClass('tio-visible-outlined');
                }
            });

            // Language selector
            $('#languageBtn').on('click', function(e) {
                e.stopPropagation();
                $('#languageDropdown').toggleClass('active');
            });

            $(document).on('click', function(e) {
                if (!$(e.target).closest('.language-selector').length) {
                    $('#languageDropdown').removeClass('active');
                }
            });

            // Form submission with loading state
            $('#form-id').on('submit', function() {
                $('#signInBtn').addClass('loading').prop('disabled', true);
            });

            // Keyboard shortcut (Enter key)
            $(document).on('keypress', function(e) {
                if (e.which === 13 && !$('#form-id').is(':focus-within')) {
                    $('#form-id').submit();
                }
            });

            // Image error handling
            $('.onerror-image').on('error', function() {
                $(this).attr('src', $(this).data('onerror-image'));
            });
        });

        // Refresh captcha
        $(document).on('click', '.reloadCaptcha', function() {
            $.ajax({
                url: "{{ route('reload-captcha') }}",
                type: "GET",
                dataType: 'json',
                beforeSend: function() { $('.refresh-captcha').addClass('active'); },
                success: function(data) { $('#reload-captcha').html(data.view); },
                complete: function() { $('.refresh-captcha').removeClass('active'); }
            });
        });
    </script>

    @if(isset($recaptcha) && $recaptcha['status'] == 1)
        <script src="https://www.google.com/recaptcha/api.js?render={{$recaptcha['site_key']}}"></script>
        <script>
            $(document).ready(function() {
                // Check if reCAPTCHA loaded successfully
                setTimeout(function() {
                    if (typeof grecaptcha === 'undefined') {
                        // reCAPTCHA failed to load - automatically switch to custom captcha
                        $('#reload-captcha').removeClass('d-none').addClass('animated fadeIn');
                        $('#custome_recaptcha').prop('required', true);
                        $('#set_default_captcha_value').val('1');
                        toastr.info('{{translate('messages.using_backup_verification')}}', '{{translate('messages.info')}}', {
                            CloseButton: true,
                            ProgressBar: true,
                            timeOut: 3000
                        });
                    }
                }, 2000);
            });

            $('#signInBtn').click(function(e) {
                // If already using custom captcha, submit normally
                if($('#set_default_captcha_value').val() == 1) {
                    $('#form-id').submit();
                    return true;
                }

                // Prevent default and try reCAPTCHA
                e.preventDefault();

                // Check if reCAPTCHA is available
                if (typeof grecaptcha === 'undefined') {
                    // Switch to custom captcha
                    $('#reload-captcha').removeClass('d-none').addClass('animated fadeIn');
                    $('#custome_recaptcha').prop('required', true);
                    $('#set_default_captcha_value').val('1');
                    toastr.info('{{translate('messages.complete_verification_below')}}', '{{translate('messages.verification_required')}}', {
                        CloseButton: true,
                        ProgressBar: true
                    });

                    // Remove loading state from button
                    $('#signInBtn').removeClass('loading').prop('disabled', false);
                    return false;
                }

                // Execute reCAPTCHA
                grecaptcha.ready(function() {
                    grecaptcha.execute('{{$recaptcha['site_key']}}', {action: 'submit'}).then(function(token) {
                        $('#g-recaptcha-response').val(token);
                        $('#form-id').submit();
                    }).catch(function(error) {
                        // reCAPTCHA execution failed - switch to custom captcha
                        $('#reload-captcha').removeClass('d-none').addClass('animated fadeIn');
                        $('#custome_recaptcha').prop('required', true);
                        $('#set_default_captcha_value').val('1');
                        $('#signInBtn').removeClass('loading').prop('disabled', false);
                        toastr.warning('{{translate('messages.use_verification_code_below')}}', '{{translate('messages.verification_method_changed')}}', {
                            CloseButton: true,
                            ProgressBar: true
                        });
                    });
                });
            });
        </script>
