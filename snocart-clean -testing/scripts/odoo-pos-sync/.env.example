# Snocart POS Environment Configuration
# Copy this file to .env and fill in your values

# ==============================================
# IMPORTANT: REQUIRED SETTINGS
# ==============================================

# Your Snocart API Key (Get this from Snocart Vendor Dashboard)
SNOCART_API_KEY=your_api_key_here

# Snocart API URL (usually https://new.snocart.com or your custom domain)
SNOCART_API_URL=https://new.snocart.com

# Odoo Admin Password (Choose a strong password)
ODOO_ADMIN_PASSWORD=your_strong_password_here

# ==============================================
# OPTIONAL SETTINGS (Advanced)
# ==============================================

# Sync interval in seconds (default: 300 = 5 minutes)
SYNC_INTERVAL=300

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# PostgreSQL settings (change only if you know what you're doing)
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_secure_password_2024
POSTGRES_DB=odoo_pos

# Odoo database name
ODOO_DB=odoo_pos

# Odoo username (default admin user)
ODOO_USERNAME=admin
